# Adresse du backend, sans "/" final.
# En developpement : .env.development (deja fourni).
# En production : a definir sur l'hebergeur, ex. https://api.koko.bj
# "npm run build" refuse de tourner si cette variable est absente.
# Test local du build : VITE_API_URL=http://localhost:4000 npm run build
# Attention : les cookies du backend sont sameSite "strict" — le front et
# l'API doivent partager le meme domaine (app.koko.bj / api.koko.bj).
# Jamais de secret ici : toute variable VITE_* est visible dans le navigateur.
VITE_API_URL=http://localhost:4000
