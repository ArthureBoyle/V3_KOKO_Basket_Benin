# Adresse du backend, sans "/" final.
# En developpement : .env.development (deja fourni).
# En production : a definir sur l'hebergeur, ex. https://api.koko.bj
# "npm run build" refuse de tourner si cette variable est absente.
# Test local du build : VITE_API_URL=http://localhost:4100 npm run build
# Attention : les cookies du backend sont sameSite "strict" — le front et
# l'API doivent partager le meme domaine (app.koko.bj / api.koko.bj).
# Jamais de secret ici : toute variable VITE_* est visible dans le navigateur.
VITE_API_URL=http://localhost:4100

# Prefixe de l'espace administrateur : PAS "/admin" (adresse devinable).
# Une chaine longue et aleatoire (16 caracteres minimum, lettres/chiffres/-/_),
# ex. generee avec : echo "/k$(openssl rand -hex 14)"
# A mettre dans .env.development.local (ignore par git) et sur l'hebergeur.
# Pas un secret (visible dans le JS du navigateur) : juste introuvable au hasard.
# La vraie protection reste cote serveur (session + role + code admin).
VITE_ADMIN_PATH=/remplace-moi-par-une-chaine-aleatoire
