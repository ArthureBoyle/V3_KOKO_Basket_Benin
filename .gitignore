# Documentation de repère perso — pas versionnée, jamais poussée sur GitHub
# Ancre a la racine du repo (/docs/) expres : sans le "/" de tete, ce
# motif matchait N'IMPORTE QUEL dossier "docs" a toute profondeur, y
# compris backend/src/docs/ (notre doc Swagger reelle) -- silencieusement
# jamais commit sans qu'on s'en rende compte.
/docs/

# Notes d'apprentissage personnelles — jamais versionnées
notes-apprentissage/

# Dépendances
node_modules/

# Build
backend/dist/

# Secrets — jamais commités, ni maintenant ni plus tard
.env
backend/.env

# Fichiers uploadés par les utilisateurs — jamais versionnés
backend/uploads/*
!backend/uploads/**/.gitkeep

# Artefacts Windows/WSL (flux de données alternatifs sur fichiers copiés)
*:Zone.Identifier

# Éditeurs / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
