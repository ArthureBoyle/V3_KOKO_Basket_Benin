// ================================================
// SCHEMA KOKO V3 — decoupe et discute modele par modele
// avec l'utilisateur avant d'etre ecrit ici.
// ================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum RoleUtilisateur {
  ADMIN
  ORGANISATEUR
  JOUEUR
}

enum StatutTournoi {
  A_VENIR
  ACTIF
  TERMINE
  ANNULE
}

// Pas de EN_COURS : aurait demande un champ duree sur Match pour savoir
// quand un match "en cours" se termine. EN_RETARD ne coute rien (juste
// une comparaison de date), TERMINE est pilote par la saisie du score
// (pas par l'horloge) — voir matchStatut.ts.
enum StatutMatch {
  A_VENIR
  EN_RETARD
  REPORTE
  TERMINE
  ANNULE
}

enum StatutCertification {
  EN_ATTENTE
  CERTIFIE
  SUSPENDU
}

// Progression de niveaux d'un MEME calcul (moyenne bayesienne), pas 4
// algorithmes independants : chaque niveau ajoute un terme au precedent.
// POINTS_PONDERES_FAUTES_CONTRES est le plus complet, POINTS_BRUTS le
// plus simple (compatible avec un organisateur qui ne saisit aucune
// stat detaillee — seul le classement equipes, base sur les scores de
// match, fonctionne alors reellement).
enum AlgorithmeClassement {
  POINTS_BRUTS
  POINTS_PONDERES
  POINTS_PONDERES_FAUTES
  POINTS_PONDERES_FAUTES_CONTRES
}

model User {
  id                 Int             @id @default(autoincrement())
  email              String          @unique @db.VarChar(30)
  motDePasse         String          @db.VarChar(60)
  role               RoleUtilisateur
  actif              Boolean         @default(true)
  mustChangePassword Boolean         @default(true)
  emailReel          String?         @db.VarChar(254)
  nom                String          @db.VarChar(100)
  prenom             String          @db.VarChar(100)
  createdAt          DateTime        @default(now())

  joueur        Joueur?
  tournois      Tournoi[]
  refreshTokens RefreshToken[]
}

// Jeton de renouvellement — une chaine aleatoire (jamais un JWT), stockee
// HASHEE (sha256), jamais en clair : si la base fuit un jour, un hash ne
// permet pas de rejouer une session, contrairement au token brut.
model RefreshToken {
  id        Int      @id @default(autoincrement())
  token     String   @unique @db.VarChar(64) // hex sha256 = 64 caracteres, fixe
  userId    Int
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])
}

model Joueur {
  id            Int       @id @default(autoincrement())
  idKoko        String    @unique @db.VarChar(20)
  nomLegal      String    @db.VarChar(100)
  prenom        String    @db.VarChar(100)
  surnom        String?   @db.VarChar(50)
  dateNaissance DateTime? @db.Date
  userId        Int       @unique
  createdAt     DateTime  @default(now())

  user     User            @relation(fields: [userId], references: [id])
  equipes  EquipeJoueur[]
  stats    Stat[]
  tournois TournoiJoueur[]
}

model Tournoi {
  id             Int           @id @default(autoincrement())
  nom            String        @db.VarChar(150)
  lieu           String        @db.VarChar(150)
  description    String?
  dateDebut      DateTime      @db.Date
  dateFin        DateTime      @db.Date
  statut         StatutTournoi @default(A_VENIR)
  organisateurId Int
  // Licences payees et nombre d'equipes autorises — fixes par l'ADMIN a
  // la creation, mais modifiables ensuite par lui seul (meme porte que
  // les dates) si l'organisateur negocie une extension hors app.
  licencesMax    Int
  equipesMax     Int
  // Reglages du classement joueurs — reserves a l'ADMIN (meme porte que
  // licencesMax/equipesMax), modifiables apres coup. Voir utils/classement.ts.
  algorithmeClassement    AlgorithmeClassement @default(POINTS_PONDERES_FAUTES)
  coefficientLissage      Int                  @default(3)   // k
  coefficientMalusFautes  Float                @default(0.6) // c
  coefficientBoostContres Float                @default(0.6) // b
  createdAt      DateTime      @default(now())

  organisateur     User             @relation(fields: [organisateurId], references: [id])
  equipes          Equipe[]
  matchs           Match[]
  joueursAssignes  TournoiJoueur[]
}

// Le "pool" de joueurs que l'ADMIN assigne a un tournoi (licences
// accordees). L'organisateur ne choisit JAMAIS un joueur en dehors de ce
// pool — il n'a donc jamais besoin de chercher/deviner un idKoko.
model TournoiJoueur {
  id        Int      @id @default(autoincrement())
  tournoiId Int
  joueurId  Int
  assigneLe DateTime @default(now())

  tournoi Tournoi @relation(fields: [tournoiId], references: [id])
  joueur  Joueur  @relation(fields: [joueurId], references: [id])

  @@unique([tournoiId, joueurId])
}

model Equipe {
  id        Int     @id @default(autoincrement())
  nom       String  @db.VarChar(100)
  couleur   String  @db.VarChar(7)
  logo      String?
  tournoiId Int

  tournoi Tournoi        @relation(fields: [tournoiId], references: [id])
  joueurs EquipeJoueur[]
  matchs1 Match[]        @relation("Equipe1")
  matchs2 Match[]        @relation("Equipe2")
  stats   Stat[]

  @@index([tournoiId])
}

model EquipeJoueur {
  id              Int                 @id @default(autoincrement())
  equipeId        Int
  // Denormalise depuis equipe.tournoiId au moment de la creation — sert
  // UNIQUEMENT a poser la contrainte d'unicite ci-dessous en base (un
  // joueur ne peut appartenir qu'a UNE SEULE equipe par tournoi, jamais
  // deux en meme temps, meme en cas de requetes concurrentes).
  tournoiId       Int
  joueurId        Int
  numeroDeMaillot Int
  statut          StatutCertification @default(EN_ATTENTE)

  equipe Equipe @relation(fields: [equipeId], references: [id])
  joueur Joueur @relation(fields: [joueurId], references: [id])

  @@unique([tournoiId, joueurId])
  @@unique([equipeId, numeroDeMaillot])
}

model Match {
  id            Int         @id @default(autoincrement())
  tournoiId     Int
  equipe1Id     Int
  equipe2Id     Int
  date          DateTime
  dateOriginale DateTime?
  lieu          String      @db.VarChar(150)
  type          String      @db.VarChar(50)
  statut        StatutMatch @default(A_VENIR)
  score1        Int?
  score2        Int?
  // Nombre de fois ou l'ORGANISATEUR a CORRIGE le score apres la saisie
  // initiale (la saisie initiale elle-meme ne compte pas). Plafonne a 2
  // cote controller (1 saisie + 2 corrections = 3 au total) ; l'ADMIN
  // n'est jamais soumis a cette limite et ne l'incremente pas.
  nombreCorrectionsScore Int @default(0)
  arbitre       String?     @db.VarChar(100)

  tournoi Tournoi @relation(fields: [tournoiId], references: [id])
  equipe1 Equipe  @relation("Equipe1", fields: [equipe1Id], references: [id])
  equipe2 Equipe  @relation("Equipe2", fields: [equipe2Id], references: [id])
  stats   Stat[]

  @@index([tournoiId])
}

model Stat {
  id       Int @id @default(autoincrement())
  matchId  Int
  joueurId Int
  equipeId Int
  points   Int @default(0)
  fautes   Int @default(0)
  contres  Int @default(0)
  tempsJeu Int @default(0)
  // Meme principe anti-abus que Match.nombreCorrectionsScore : 1 saisie
  // + 2 corrections max pour l'ORGANISATEUR, illimite pour l'ADMIN — les
  // stats alimentent le classement, meme enjeu que le score du match.
  nombreCorrections Int @default(0)

  match  Match  @relation(fields: [matchId], references: [id])
  joueur Joueur @relation(fields: [joueurId], references: [id])
  equipe Equipe @relation(fields: [equipeId], references: [id])

  @@unique([matchId, joueurId])
}
