PORT=4000
FRONTEND_URL=http://localhost:5173

# Secret de signature de l'access token (JWT, 15 min). OBLIGATOIRE, sans
# valeur par défaut : un secret vide ou partagé rendrait tous les tokens
# forgeables. Génère le tien :  openssl rand -hex 32
#
# Le refresh token (7 jours), lui, n'est PAS un JWT — une chaîne aléatoire
# stockée hashée en base (voir src/utils/tokens.ts) — donc pas besoin
# d'un second secret pour lui.
JWT_ACCESS_SECRET=

# Base locale (Docker Compose de ce dossier). Ces identifiants doivent
# correspondre EXACTEMENT à docker-compose.yml — utilisateur koko,
# port 5433 côté hôte.
#   docker compose up -d          (depuis backend/)
DATABASE_URL="postgresql://koko:koko_local_dev@localhost:5433/koko?schema=public"
DIRECT_URL="postgresql://koko:koko_local_dev@localhost:5433/koko?schema=public"

# En production : DATABASE_URL/DIRECT_URL pointent vers Supabase (ou
# équivalent managé), jamais vers ce Postgres local — voir
# docs/Koko V3 – Technologies Et Stack Technique.md
